{
  "version": 1,
  "constants": {
    "ROUTE_TOKEN_SIGN_TTL_SECONDS": 30,
    "ADMISSION_DEADLINE_MS": 60000,
    "DECOY_AUTH_MAX_BYTES": 4096,
    "DECOY_DEADLINE_MS": 10000,
    "DECOY_MAX_BYTES": 65536,
    "DECOY_MAX_FRAMES": 128,
    "DECOY_SCRAM_ITERATIONS": 4096,
    "MAX_SQL_REQUEST_BYTES": 4194304,
    "MAX_SQL_STATEMENTS": 256,
    "REFUSAL_BYTES": 512,
    "ROUTE_TOKEN_MAX_LENGTH": 1280,
    "ROUTE_TOKEN_MAX_LIFETIME_SECONDS": 30,
    "ROUTE_TOKEN_SKEW_SECONDS": 5,
    "ROUTE_KEY_MIN_BYTES": 32,
    "SSL_REQUEST_CODE": 80877103,
    "GSSENC_REQUEST_CODE": 80877104,
    "CANCEL_REQUEST_CODE": 80877102,
    "STARTUP_MIN_LENGTH": 8,
    "STARTUP_MAX_LENGTH": 10000,
    "MAX_PRELUDES": 2,
    "DEFAULT_MAX_BUFFERED": 65536,
    "CANCEL_MIN_LENGTH": 16,
    "CANCEL_MAX_LENGTH": 268,
    "ROUTE_TOKEN_SIGNATURE_BYTES": 32,
    "DEFAULT_MEMORY_LIMIT_BYTES": 201326592,
    "DEFAULT_DATABASE_MEMORY_LIMIT_BYTES": 100663296,
    "MAX_PAYLOAD_BYTES": 33554432,
    "MAX_FRAME_BYTES": 65536,
    "MAX_STARTUP_BUFFER_BYTES": 65536,
    "DEFAULT_DATABASE_CONNECTION_LIMIT": 200,
    "DEFAULT_TOTAL_CONNECTION_LIMIT": 2000,
    "MAX_ACTIVITY_RECORDS": 2000
  },
  "wire": {
    "routeKeyDomain": "pgcf-route-key/v2\n",
    "routeHeader": "X-PGCF-Route",
    "accessClientIdHeader": "CF-Access-Client-Id",
    "accessClientSecretHeader": "CF-Access-Client-Secret",
    "accessSecretsIncomplete": "access_secrets_incomplete",
    "decoySaltDomain": "pgcf.edge.decoy-scram-salt/v1\n",
    "wakeRouteTokenPrefix": "v5",
    "wakeRouteSignatureDomain": "pgcf-route/v5\n",
    "nodeRouteTokenPrefix": "v6",
    "nodeRouteSignatureDomain": "pgcf-route/v6\n",
    "nodeRouteKeyDomain": "pgcf-route-key/v2\n"
  },
  "patterns": {
    "database": "^[a-z][a-z0-9]{19}$",
    "region": "^[a-z][a-z0-9-]{1,30}[a-z0-9]$",
    "role": "^[a-z][a-z0-9_]{0,62}$",
    "operation": "^op_[a-z0-9]{20}$",
    "node": "^nod_[a-z0-9]{20}$",
    "uuid": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
  },
  "reservedRoles": ["postgres", "streaming_replica"],
  "reservedRolePrefixes": ["pg_", "cnpg_"],
  "gatewayRegion": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": { "$ref": "#/$defs/RegionId" },
      "gateway_url": { "type": "string", "maxLength": 2048, "format": "uri" },
      "gateway_binding": {
        "anyOf": [
          { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
          { "type": "null" }
        ]
      }
    },
    "required": ["id", "gateway_url", "gateway_binding"],
    "additionalProperties": false,
    "$defs": {
      "RegionId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,30}[a-z0-9]$"
      }
    }
  },
  "databaseAdmission": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "const": true },
          "region": {
            "type": "object",
            "properties": {
              "id": { "$ref": "#/$defs/RegionId" },
              "gateway_url": {
                "type": "string",
                "maxLength": 2048,
                "format": "uri"
              },
              "gateway_binding": {
                "anyOf": [
                  { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
                  { "type": "null" }
                ]
              }
            },
            "required": ["id", "gateway_url", "gateway_binding"],
            "additionalProperties": false
          },
          "node": { "$ref": "#/$defs/NodeId" },
          "target": {
            "type": "object",
            "properties": {
              "revision": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "route_revision": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "instance": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "required": ["revision", "route_revision", "instance"],
            "additionalProperties": false
          }
        },
        "required": ["ok", "region", "node", "target"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "const": false },
          "sqlstate": {
            "type": "string",
            "enum": ["53300", "3D000", "28P01", "57P03", "08006"]
          }
        },
        "required": ["ok", "sqlstate"],
        "additionalProperties": false
      }
    ],
    "$defs": {
      "RegionId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,30}[a-z0-9]$"
      },
      "NodeId": { "type": "string", "pattern": "^nod_[a-z0-9]{20}$" }
    }
  },
  "wakeRouteClaims": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "v": { "type": "number", "const": 5 },
      "db": { "type": "string", "pattern": "^[a-z][a-z0-9]{19}$" },
      "user": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
      "cid": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "rg": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}[a-z0-9]$" },
      "kid": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$"
      },
      "iat": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "exp": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "op": { "type": "string", "pattern": "^op_[a-z0-9]{20}$" },
      "gen": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "route_revision": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "rh": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "required": [
      "v",
      "db",
      "user",
      "cid",
      "rg",
      "kid",
      "iat",
      "exp",
      "op",
      "gen",
      "route_revision",
      "rh"
    ],
    "additionalProperties": false,
    "$defs": {
      "RoleName": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
      "OperationId": { "type": "string", "pattern": "^op_[a-z0-9]{20}$" }
    }
  },
  "nodeRouteClaims": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "v": { "type": "number", "const": 6 },
      "db": { "type": "string", "pattern": "^[a-z][a-z0-9]{19}$" },
      "user": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
      "cid": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "rg": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}[a-z0-9]$" },
      "kid": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$"
      },
      "iat": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "exp": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "rev": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "route_revision": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "node": { "type": "string", "pattern": "^nod_[a-z0-9]{20}$" },
      "inst": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    },
    "required": [
      "v",
      "db",
      "user",
      "cid",
      "rg",
      "kid",
      "iat",
      "exp",
      "rev",
      "route_revision",
      "node",
      "inst"
    ],
    "additionalProperties": false,
    "$defs": {
      "RoleName": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
      "NodeId": { "type": "string", "pattern": "^nod_[a-z0-9]{20}$" }
    }
  }
}
