      {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "const": false },
          "sqlstate": {
            "type": "string",
            "enum": ["53300", "3D000", "28P01", "57P03", "08006"]
          }
        },
        "required": ["ok", "sqlstate"],
        "additionalProperties": false
      }
    ],
    "$defs": {
      "RegionId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,30}[a-z0-9]$"
      }
    }
