      "DatabaseId": { "type": "string", "pattern": "^[a-z][a-z0-9]{19}$" },
      "OperationId": { "type": "string", "pattern": "^op_[a-z0-9]{20}$" }
    }
  },
  "legacyStorageBinding": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "database_id": { "$ref": "#/$defs/DatabaseId" },
      "storage_uid": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "namespace_uid": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "cluster_uid": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "physical_generation": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "volume_identity": {
        "type": "object",
        "properties": {
          "handle": { "type": "string", "pattern": "^pvc-[a-f0-9-]{36}$" },
          "claimUid": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "volumeUid": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "lvUuid": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{6}-(?:[A-Za-z0-9]{4}-){5}[A-Za-z0-9]{6}$"
          }
        },
        "required": ["handle", "claimUid", "volumeUid"],
        "additionalProperties": false
      }
    },
    "required": [
      "database_id",
      "storage_uid",
      "namespace_uid",
      "cluster_uid",
      "physical_generation",
      "volume_identity"
    ],
    "additionalProperties": false,
    "$defs": {
      "DatabaseId": { "type": "string", "pattern": "^[a-z][a-z0-9]{19}$" }
    }
  },
  "storageHostLease": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "purpose": { "type": "string", "const": "pgcf-storage-host/v1" },
      "node_uid": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "boot_id": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          { "type": "null" }
        ]
      },
      "material_revision": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "issued_at": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "expires_at": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "legacy": {
        "maxItems": 2000,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "database_id": { "$ref": "#/$defs/DatabaseId" },
            "generation": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "namespace": {
              "type": "string",
              "pattern": "^pgcf-db-[a-z0-9]{20}$"
            }
          },
          "required": ["database_id", "generation", "namespace"],
          "additionalProperties": false
        }
      },
      "databases": {
        "maxItems": 4096,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "database_id": { "$ref": "#/$defs/DatabaseId" },
            "generation": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "authority_revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "write_blocked": { "type": "boolean" },
            "desired_state": {
              "type": "string",
              "enum": ["running", "suspended", "deleted"]
            },
            "node_uid": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "volume_group_uuid": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{6}-(?:[A-Za-z0-9]{4}-){5}[A-Za-z0-9]{6}$"
            },
            "pool_uuid": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{6}-(?:[A-Za-z0-9]{4}-){5}[A-Za-z0-9]{6}$"
            },
            "profile_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "startup_expires_at": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                { "type": "null" }
              ]
            },
            "startup_operation_id": {
              "anyOf": [{ "$ref": "#/$defs/OperationId" }, { "type": "null" }]
            },
            "volume": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "storage_generation": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "storage_uid": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "namespace_uid": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "cluster_uid": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "node_uid": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "volume_group_uuid": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9]{6}-(?:[A-Za-z0-9]{4}-){5}[A-Za-z0-9]{6}$"
                    },
                    "pool_uuid": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9]{6}-(?:[A-Za-z0-9]{4}-){5}[A-Za-z0-9]{6}$"
                    },
                    "volume_handle": {
                      "type": "string",
                      "pattern": "^pvc-[a-f0-9-]{36}$"
                    },
                    "lv_uuid": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9]{6}-(?:[A-Za-z0-9]{4}-){5}[A-Za-z0-9]{6}$"
                    },
                    "pvc_uid": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "pv_uid": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  },
                  "required": [
                    "storage_generation",
                    "storage_uid",
                    "namespace_uid",
                    "cluster_uid",
                    "node_uid",
                    "volume_group_uuid",
                    "pool_uuid",
                    "volume_handle",
                    "lv_uuid",
                    "pvc_uid",
                    "pv_uid"
                  ],
                  "additionalProperties": false
                },
                { "type": "null" }
              ]
            },
            "runtime_authority": {
              "anyOf": [
                { "type": "string", "maxLength": 4096 },
                { "type": "null" }
              ]
            },
            "drain": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "operation_id": { "$ref": "#/$defs/OperationId" },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "database.suspend",
                        "database.hibernate",
                        "database.delete"
                      ]
                    },
                    "generation": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "authority_revision": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "expires_at": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "budget_bytes": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "operation_id",
                    "kind",
                    "generation",
                    "authority_revision",
                    "expires_at",
                    "budget_bytes"
                  ],
                  "additionalProperties": false
                },
                { "type": "null" }
              ]
            }
          },
          "required": [
            "database_id",
            "generation",
            "authority_revision",
            "write_blocked",
            "desired_state",
            "node_uid",
            "volume_group_uuid",
            "pool_uuid",
            "profile_sha256",
            "startup_expires_at",
            "startup_operation_id",
            "volume",
            "runtime_authority"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "purpose",
      "node_uid",
      "boot_id",
      "material_revision",
      "issued_at",
      "expires_at",
      "legacy",
      "databases"
    ],
    "additionalProperties": false,
    "$defs": {
      "DatabaseId": { "type": "string", "pattern": "^[a-z][a-z0-9]{19}$" },
      "OperationId": { "type": "string", "pattern": "^op_[a-z0-9]{20}$" }
    }
  }
}
