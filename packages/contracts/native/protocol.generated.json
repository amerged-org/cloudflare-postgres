          { "type": "null" }
        ]
      }
    },
    "required": ["id", "gateway_url", "gateway_binding"],
    "additionalProperties": false,
    "$defs": {
      "RegionId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,30}[a-z0-9]$"
      }
    }
  },
