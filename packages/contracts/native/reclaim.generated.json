            "binding_id",
            "scope_sha256",
            "holder_revision",
            "pool_namespace_uid",
            "pool_namespace_resource_version"
          ],
          "additionalProperties": false
        }
      ],
      "$defs": {
        "DatabaseId": { "type": "string", "pattern": "^[a-z][a-z0-9]{19}$" },
        "RegionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,30}[a-z0-9]$"
        },
        "RoleName": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" }
      }
    }
  },
  "constants": {
    "RECLAIM_LIMITS": {
      "lease_ms": 5000,
      "clock_skew_ms": 1000,
      "max_token_bytes": 8192,
      "max_envelope_bytes": 2097152,
      "max_budget_bytes": 134217728,
      "max_step_bytes": 8388608,
      "snapshot_ms": 2000,
      "max_tasks": 4096
    },
    "RECLAIM_DOMAIN": "pgcf-reclaim-authority/v1\n",
    "RECLAIM_PREFIX": "rc1",
    "RECLAIM_FILES": {
      "tasks": "/run/pgcf-reclaim-input/reclaim.json",
      "intents": "/run/pgcf-reclaim-input/reclaim-intents.json",
      "state": "/var/lib/pgcf-reclaimer/state.json",
      "report": "/run/pgcf-reclaimer/report.json"
    }
  }
}
