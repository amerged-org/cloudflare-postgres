# SPDX-License-Identifier: Apache-2.0
# One PostgreSQL per database; the instance is the database ID. The agent is the only starter:
# nothing enables this unit, and systemd never restarts it on its own (every start goes through
# the agent's admission). The agent sets the per-database limits (MemoryMax, MemoryHigh, CPUWeight,
# IO limits, TasksMax) as persistent unit properties, never by reloading; CPUQuota only after
# ready, cleared again at stop (the empty assignment CPUQuota=). It creates the socket directory
# /run/pgcf/<id> (owner pgcf-<id>, group pgcf-gateway, mode 0750) when it creates the database and
# at its own start, and removes it with the database; no ExecStartPre= does, which would add a
# process to every start.
#
# The unit mounts its own volume (MountImages=), from the link /run/pgcf/dev/<id> that the agent
# keeps: it points to the device of the generation the agent has attached and mounted in its own
# mount namespace (pgcf-agent.service), and exists only while the agent has it attached. No volume
# is in PID 1's mount namespace: systemd's executor copies that namespace for every unit it starts
# and reads its mount table about 64 times, so a start would take longer with every volume mounted
# there (about 1 ms per volume on EU1). The second mount of a filesystem that is mounted already
# costs next to nothing, and both mounts are one superblock: what the agent writes while the
# database is stopped, and its resize and fstrim while it runs, are seen at once.
[Unit]
Description=PGCF database %i
Documentation=https://github.com/amerged-org/cloudflare-postgres/blob/main/infra/node-image/README.md
# A start without the agent's link fails, not silently skips and not on an empty directory.
AssertPathExists=/run/pgcf/dev/%i

[Service]
Type=notify
NotifyAccess=main
User=pgcf-%i
Group=pgcf-%i
Slice=pgcf.slice
# postgres itself, never pg_ctl: the postmaster sends READY=1 when it accepts connections.
ExecStart=/usr/lib/postgresql/18/bin/postgres -D /var/lib/pgcf/db/%i/data -c listen_addresses= -c unix_socket_directories=/run/pgcf/%i
# READY=1 comes only after crash recovery or a restore's replay, which can outlast any fixed
# timeout (Stage 1 replayed for 97 s); the agent owns the start deadline.
TimeoutStartSec=infinity
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=30
Restart=no
OOMPolicy=continue
OOMScoreAdjust=-900
Environment=PG_OOM_ADJUST_FILE=/proc/self/oom_score_adj
Environment=PG_OOM_ADJUST_VALUE=0
UMask=0077

# Smallest class until the agent applies the database's own size.
MemoryMax=256M
MemoryHigh=230M
MemorySwapMax=0
TasksMax=64
CPUWeight=100

PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectSystem=strict
# The socket directory must exist: a start without it fails instead of running unreachable. The
# volume is not listed here: it is writable as a mount of the unit's own, and listing a path that
# is not on the host fails with ENOENT. Never `ro` among the mount options: the second mount of a
# filesystem that is mounted read-write fails with it (226/NAMESPACE).
ReadWritePaths=/run/pgcf/%i
MountImages=/run/pgcf/dev/%i:/var/lib/pgcf/db/%i:root:nosuid,nodev,noexec,noatime
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# PostgreSQL maps its segments here read-write only; nothing in it may run, carry setuid or be a device.
TemporaryFileSystem=/dev/shm:size=64M,mode=1777,noexec,nosuid,nodev
# Nothing writable is shared with another unit. The unit has its own IPC namespace (its own SysV
# segments and its own POSIX queue mount: PostgreSQL's segment is in it, and no other unit's is).
# Three places stay outside the unit's view. /run/lock is a tmpfs for the whole node and
# /dev/mqueue is mode 1777: both were mounted read-write in every unit, a place where one
# database's user leaves what another reads, and files that outlive the unit. /dev/pts is the
# host's devpts, which PrivateDevices= binds into the private /dev: its ptmx gave one user 3072
# of the node's 4096 ptys, and its listing showed the ptys of every unit. PostgreSQL uses none of
# them. The filter below denies mq_open, but creating a file in /dev/mqueue makes the same queue,
# so the directory is out of reach as well. The PID namespace stays shared, because the pid half of
# PostgreSQL's interlock (a second postmaster on the directory finds the first with kill(pid, 0))
# needs it; the segment half does not reach across IPC namespaces.
PrivateIPC=yes
InaccessiblePaths=-/run/lock -/dev/mqueue -/dev/pts
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# @system-service allows what kernel exploits use as their second stage: io_uring, userfaultfd, the
# kernel keyring, the message queues and the SysV semaphores. PostgreSQL needs none of them
# (io_method=worker, SysV shared memory, unnamed POSIX semaphores); shmget, shmat, shmdt and shmctl
# stay allowed. The line follows the allow line above, because systemd merges the lines in order.
SystemCallFilter=~@keyring io_uring_setup io_uring_enter io_uring_register userfaultfd msgget msgsnd msgrcv msgctl semget semop semtimedop semctl mq_open mq_unlink mq_timedsend mq_timedreceive mq_notify mq_getsetattr
MemoryDenyWriteExecute=yes
