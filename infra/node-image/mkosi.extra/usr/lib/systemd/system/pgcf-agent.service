# SPDX-License-Identifier: Apache-2.0
# The node agent: the only local actor (LVM, mounts, users, systemd, backups, the Cloudflare link).
# It runs as root in a mount namespace of its own (PrivateMounts=) on purpose: the volumes it
# mounts stay out of PID 1's namespace, which every unit's executor copies and reads again and
# again, so that the cost of a start does not grow with the number of volumes. The database units
# and the jobs mount their volumes themselves (MountImages=, from the links the agent keeps in
# /run/pgcf/dev). The agent joins the namespace of pgcf-mounts.service, a transient unit it starts
# (`pgcf-agent hold`), before its first thread: the namespace then outlives the agent, whose death
# unmounts nothing (the kernel unmounts a dying process's namespace volume by volume: 14 s with 312
# volumes). The namespace this unit makes is the one of an agent that could not join, and ends with
# it. A restart never stops a database, because database units are independent units with mounts
# of their own.
[Unit]
Description=PGCF node agent
Documentation=https://github.com/amerged-org/cloudflare-postgres/blob/main/infra/node-image/README.md
Wants=dbus.service
After=local-fs.target dbus.service systemd-repart.service
StartLimitIntervalSec=0

[Service]
Type=notify
ExecStart=/var/lib/pgcf/bin/current/pgcf-agent run
Restart=always
RestartSec=1s
KillMode=control-group
# No filesystem sandboxing beyond this: the agent needs to see the node. Its mounts (volumes,
# attach, fstrim, resize) are made in the private copy and never reach PID 1 or the executors.
PrivateMounts=yes
# The gateway's channel (gateway.sock) and the databases' archive socket (archive.sock).
RuntimeDirectory=pgcf/agent
RuntimeDirectoryMode=0755
OOMScoreAdjust=-900
MemoryLow=128M

[Install]
WantedBy=multi-user.target
