+// Copyright 2026 PGCF contributors
+// SPDX-License-Identifier: Apache-2.0
+package collector
+
+import (
+	"github.com/openebs/lvm-localpv/pkg/lvm"
+	"github.com/prometheus/client_golang/prometheus"
+	dto "github.com/prometheus/client_model/go"
+	"strings"
+	"testing"
+)
+
+func TestMetricsEmitterKeepsInventoryWithoutInventingUtilization(t *testing.T) {
+	c := NewLvCollector().(*lvCollector)
+	rows := []lvm.LogicalVolumeMetrics{
+		{LogicalVolume: lvm.LogicalVolume{Name: "pgcf_thinpool", UUID: "pool", VGName: "pgcf", SegType: "thin-pool", Size: 16777216, DMPath: "/dev/mapper/pgcf-pgcf_thinpool", ActiveStatus: "active", Permission: 1, MetadataSize: 4194304}, MetadataSizeKnown: true},
+		{LogicalVolume: lvm.LogicalVolume{Name: "scratch", UUID: "raw", VGName: "pgcf", SegType: "thin", PoolName: "pgcf_thinpool", Size: 33554432, Path: "/dev/pgcf/scratch", DMPath: "/dev/mapper/pgcf-scratch", ActiveStatus: "active", Permission: 1}},
+		{LogicalVolume: lvm.LogicalVolume{Name: "spare", UUID: "spare", VGName: "pgcf", SegType: "linear", Size: 4194304, ActiveStatus: "inactive", Permission: 1}},
+	}
+	out := make(chan prometheus.Metric, 128)
+	c.collect(rows, out)
+	close(out)
+	totals := 0
+	usage := 0
+	for metric := range out {
+		var value dto.Metric
+		if err := metric.Write(&value); err != nil {
+			t.Fatal(err)
+		}
+		if strings.Contains(metric.Desc().String(), `fqName: "lvm_lv_total_size_bytes"`) {
+			totals++
+		}
+		if strings.Contains(metric.Desc().String(), `fqName: "lvm_lv_used_percent"`) || strings.Contains(metric.Desc().String(), `fqName: "lvm_lv_mda_used_percent"`) {
+			usage++
+		}
+	}
+	if totals != 3 || usage != 0 {
+		t.Fatalf("visible LV size rows=%d utilization rows=%d", totals, usage)
+	}
+}
