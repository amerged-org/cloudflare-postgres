--- a/pkg/lvm/exporter_metadata.go
+++ b/pkg/lvm/exporter_metadata.go
@@ -0,0 +1,195 @@
+// Copyright 2026 PGCF contributors
+// SPDX-License-Identifier: Apache-2.0
+package lvm
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"reflect"
+	"strconv"
+	"strings"
+
+	apis "github.com/openebs/lvm-localpv/pkg/apis/openebs.io/lvm/v1alpha1"
+	"k8s.io/apimachinery/pkg/api/resource"
+)
+
+// LogicalVolumeMetrics carries measured metadata, not CSI device-path readiness.
+// Missing utilization is distinguished from a measured zero and is not exported.
+type LogicalVolumeMetrics struct {
+	LogicalVolume
+	MetadataSizeKnown        bool
+	UsedSizePercentKnown     bool
+	MetadataUsedPercentKnown bool
+	SnapshotUsedPercentKnown bool
+}
+
+func metadataRows(raw []byte, kind string) ([]map[string]string, error) {
+	var output struct {
+		Report []map[string][]map[string]string `json:"report"`
+	}
+	if err := json.Unmarshal(raw, &output); err != nil {
+		return nil, err
+	}
+	if len(output.Report) != 1 {
+		return nil, fmt.Errorf("expected exactly one lvm metadata report")
+	}
+	rows, ok := output.Report[0][kind]
+	if !ok {
+		return nil, fmt.Errorf("lvm metadata report lacks %s inventory", kind)
+	}
+	return rows, nil
+}
+
+func metadataBytes(raw string) (int64, error) {
+	value, err := strconv.ParseInt(strings.TrimSuffix(strings.ToLower(raw), "b"), 10, 64)
+	if err != nil || value < 0 {
+		return 0, fmt.Errorf("invalid measured lvm byte count")
+	}
+	return value, nil
+}
+
+func metadataPercent(raw string) (float64, bool, error) {
+	if raw == "" {
+		return 0, false, nil
+	}
+	value, err := strconv.ParseFloat(raw, 64)
+	if err != nil || math.IsNaN(value) || math.IsInf(value, 0) || value < 0 || value > 100 {
+		return 0, false, fmt.Errorf("invalid measured lvm utilization")
+	}
+	return value, true, nil
+}
+
+// An absent field is unknown; an explicitly reported empty health string is
+// LVM's healthy value. Keep the two cases distinct for every measured enum.
+func metadataEnum(row map[string]string, field string) int {
+	value, present := row[field]
+	if !present {
+		return -1
+	}
+	return getIntFieldValue(field, value)
+}
+
+// No public LV alias is opened or resolved. Kernel minor metadata supplies the
+// convenience dm-N label when LVM actually reports an active kernel device.
+func parseLogicalVolumeMetrics(row map[string]string) (LogicalVolumeMetrics, error) {
+	var metric LogicalVolumeMetrics
+	lv := &metric.LogicalVolume
+	lv.Name, lv.FullName, lv.UUID, lv.VGName = row[LVName], row[LVFullName], row[LVUUID], row[VGName]
+	if lv.Name == "" || lv.UUID == "" || lv.VGName == "" {
+		return metric, fmt.Errorf("lvm metadata LV identity missing")
+	}
+	lv.Path, lv.DMPath, lv.ActiveStatus = row[LVPath], row[LVDmPath], row[LVActive]
+	lv.SegType, lv.Host, lv.PoolName = row[LVSegtype], row[LVHost], row[LVPool]
+	lv.Permission = metadataEnum(row, LVPermissions)
+	lv.BehaviourWhenFull = metadataEnum(row, LVWhenFull)
+	lv.HealthStatus = metadataEnum(row, LVHealthStatus)
+	lv.RaidSyncAction = metadataEnum(row, RaidSyncAction)
+	var err error
+	if lv.Size, err = metadataBytes(row[LVSize]); err != nil {
+		return metric, err
+	}
+	metric.MetadataSizeKnown = row[LVMetadataSize] != ""
+	if metric.MetadataSizeKnown {
+		if lv.MetadataSize, err = metadataBytes(row[LVMetadataSize]); err != nil {
+			return metric, err
+		}
+	}
+	if lv.UsedSizePercent, metric.UsedSizePercentKnown, err = metadataPercent(row[LVDataPercent]); err != nil {
+		return metric, err
+	}
+	if lv.MetadataUsedPercent, metric.MetadataUsedPercentKnown, err = metadataPercent(row[LVMetadataPercent]); err != nil {
+		return metric, err
+	}
+	if lv.SnapshotUsedPercent, metric.SnapshotUsedPercentKnown, err = metadataPercent(row[LVSnapPercent]); err != nil {
+		return metric, err
+	}
+	major, majorErr := strconv.ParseUint(row["lv_kernel_major"], 10, 32)
+	minor, minorErr := strconv.ParseUint(row["lv_kernel_minor"], 10, 32)
+	if majorErr == nil && minorErr == nil && major > 0 {
+		lv.Device = fmt.Sprintf("dm-%d", minor)
+	}
+	return metric, nil
+}
+
+func decodeLvsMetricsJSON(raw []byte) ([]LogicalVolumeMetrics, error) {
+	rows, err := metadataRows(raw, "lv")
+	if err != nil {
+		return nil, err
+	}
+	result := make([]LogicalVolumeMetrics, 0, len(rows))
+	seen := make(map[string]LogicalVolumeMetrics)
+	for _, row := range rows {
+		lv, err := parseLogicalVolumeMetrics(row)
+		if err != nil {
+			return nil, err
+		}
+		if previous, exists := seen[lv.UUID]; exists {
+			if !reflect.DeepEqual(previous, lv) {
+				return nil, fmt.Errorf("conflicting measured LV segment reports")
+			}
+			continue
+		}
+		seen[lv.UUID] = lv
+		result = append(result, lv)
+	}
+	return result, nil
+}
+
+func ListLVMLogicalVolumeMetrics() ([]LogicalVolumeMetrics, error) {
+	output, _, err := RunCommandSplit(LVList, "--options", "lv_all,vg_name,segtype", "--reportformat", "json", "--units", "b")
+	if err != nil {
+		return nil, err
+	}
+	return decodeLvsMetricsJSON(output)
+}
+
+// The exporter needs only vgs measurements. CSI's unchanged parseVolumeGroup
+// still performs thin-pool capacity enrichment; missing pool utilization must
+// not erase otherwise complete VG measurements from the exporter.
+func decodeVgsMetricsJSON(raw []byte) ([]apis.VolumeGroup, error) {
+	rows, err := metadataRows(raw, "vg")
+	if err != nil {
+		return nil, err
+	}
+	result := make([]apis.VolumeGroup, 0, len(rows))
+	for _, row := range rows {
+		var vg apis.VolumeGroup
+		vg.Name, vg.UUID = row[VGName], row[VGUUID]
+		if vg.Name == "" || vg.UUID == "" {
+			return nil, fmt.Errorf("lvm metadata VG identity missing")
+		}
+		counts := map[string]*int32{
+			VGPVvount: &vg.PVCount, VGLvCount: &vg.LVCount, VGMaxLv: &vg.MaxLV, VGMaxPv: &vg.MaxPV,
+			VGSnapCount: &vg.SnapCount, VGMissingPvCount: &vg.MissingPVCount,
+			VGMetadataCount: &vg.MetadataCount, VGMetadataUsedCount: &vg.MetadataUsedCount,
+		}
+		for key, target := range counts {
+			value, err := strconv.ParseInt(row[key], 10, 32)
+			if err != nil || value < 0 {
+				return nil, fmt.Errorf("invalid measured VG count %s", key)
+			}
+			*target = int32(value)
+		}
+		quantities := map[string]*resource.Quantity{VGSize: &vg.Size, VGFreeSize: &vg.Free, VGMetadataSize: &vg.MetadataSize, VGMetadataFreeSize: &vg.MetadataFree}
+		for key, target := range quantities {
+			value, err := metadataBytes(row[key])
+			if err != nil {
+				return nil, err
+			}
+			*target = *resource.NewQuantity(value, resource.BinarySI)
+		}
+		vg.Permission = metadataEnum(row, VGPermissions)
+		vg.AllocationPolicy = metadataEnum(row, VGAllocationPolicy)
+		result = append(result, vg)
+	}
+	return result, nil
+}
+
+func ListLVMVolumeGroupMetrics() ([]apis.VolumeGroup, error) {
+	output, _, err := RunCommandSplit(VGList, "--options", "vg_all", "--reportformat", "json", "--units", "b")
+	if err != nil {
+		return nil, err
+	}
+	return decodeVgsMetricsJSON(output)
+}
--- a/pkg/lvm/metrics_metadata_test.go
+++ b/pkg/lvm/metrics_metadata_test.go
@@ -0,0 +1,116 @@
+// Copyright 2026 PGCF contributors
+// SPDX-License-Identifier: Apache-2.0
+package lvm
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func metricLV(name, segtype, pool, path, dmPath, active string) map[string]string {
+	return map[string]string{
+		LVName: name, LVFullName: "pgcf/" + name, LVUUID: name + "-uuid", VGName: "pgcf",
+		LVSize: "4194304B", LVPath: path, LVDmPath: dmPath, LVActive: active,
+		LVPermissions: "writeable", LVWhenFull: "error", LVHealthStatus: "",
+		LVSegtype: segtype, LVPool: pool, LVHost: "probe",
+		LVMetadataSize: "4194304B", LVDataPercent: "", LVMetadataPercent: "", LVSnapPercent: "",
+	}
+}
+func metricReport(kind string, rows []map[string]string) []byte {
+	out, err := json.Marshal(map[string]any{"report": []any{map[string]any{kind: rows}}})
+	if err != nil {
+		panic(err)
+	}
+	return out
+}
+func TestMetricsInventoryDoesNotRequirePublicDevicePaths(t *testing.T) {
+	rows := []map[string]string{
+		metricLV("pgcf_thinpool", "thin-pool", "", "", "/dev/mapper/pgcf-pgcf_thinpool", "active"),
+		metricLV("pgcf_thin_q_probe_m", "thin", "pgcf_thinpool", "/dev/pgcf/pgcf_thin_q_probe_m", "/dev/mapper/pgcf-pgcf_thin_q_probe_m", "active"),
+		metricLV("metadata_spare", "linear", "", "", "", "inactive"),
+	}
+	got, err := decodeLvsMetricsJSON(metricReport("lv", rows))
+	if err != nil {
+		t.Fatalf("complete measured LV inventory was lost because a public alias is absent: %v", err)
+	}
+	if len(got) != len(rows) {
+		t.Fatalf("measured visible LV count = %d; want %d", len(got), len(rows))
+	}
+}
+
+func TestMetricsUnknownUtilizationIsDistinctFromMeasuredZero(t *testing.T) {
+	row := metricLV("pool", "thin-pool", "", "", "/dev/mapper/pgcf-pool", "inactive")
+	unknown, err := parseLogicalVolumeMetrics(row)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if unknown.UsedSizePercentKnown || unknown.MetadataUsedPercentKnown || unknown.SnapshotUsedPercentKnown {
+		t.Fatal("missing utilization became a measurement")
+	}
+	row[LVDataPercent] = "0.00"
+	row[LVMetadataPercent] = "0.00"
+	zero, err := parseLogicalVolumeMetrics(row)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !zero.UsedSizePercentKnown || !zero.MetadataUsedPercentKnown || zero.UsedSizePercent != 0 || zero.MetadataUsedPercent != 0 {
+		t.Fatal("a measured zero was lost")
+	}
+	row[LVDataPercent] = "NaN"
+	if _, err := parseLogicalVolumeMetrics(row); err == nil {
+		t.Fatal("invalid utilization was accepted")
+	}
+}
+func TestMetricsSegmentDuplicatesPreserveOneCompleteInventory(t *testing.T) {
+	row := metricLV("pool", "thin-pool", "", "", "/dev/mapper/pgcf-pool", "active")
+	got, err := decodeLvsMetricsJSON(metricReport("lv", []map[string]string{row, row}))
+	if err != nil || len(got) != 1 {
+		t.Fatalf("same-LV segment rows: count=%d err=%v", len(got), err)
+	}
+	different := metricLV("pool", "thin-pool", "", "", "/dev/mapper/pgcf-pool", "active")
+	different[LVSize] = "8388608B"
+	if _, err := decodeLvsMetricsJSON(metricReport("lv", []map[string]string{row, different})); err == nil {
+		t.Fatal("conflicting segment rows were silently dropped")
+	}
+	if _, err := decodeLvsJSON(metricReport("lv", []map[string]string{metricLV("missing", "linear", "", "/definitely-absent-lv", "", "active")})); err == nil {
+		t.Fatal("CSI device-path checks were weakened")
+	}
+}
+func TestMetricsVolumeGroupReadDoesNotRequireThinPoolCapacity(t *testing.T) {
+	row := map[string]string{VGName: "pgcf", VGUUID: "vg-uuid", VGSize: "103075020800B", VGFreeSize: "51531218944B", VGMetadataSize: "1048576B", VGMetadataFreeSize: "524288B", VGPermissions: "writeable", VGAllocationPolicy: "normal"}
+	for _, key := range []string{VGPVvount, VGLvCount, VGMaxLv, VGMaxPv, VGSnapCount, VGMissingPvCount, VGMetadataCount, VGMetadataUsedCount} {
+		row[key] = "0"
+	}
+	row[VGPVvount] = "1"
+	row[VGLvCount] = "6"
+	got, err := decodeVgsMetricsJSON(metricReport("vg", []map[string]string{row}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 || got[0].LVCount != 6 || got[0].Size.Value() != 103075020800 || got[0].Free.Value() != 51531218944 {
+		t.Fatal("independent vgs facts were lost")
+	}
+	if len(got[0].ThinPools) != 0 {
+		t.Fatal("exporter invented thin-pool capacity")
+	}
+	delete(row, VGFreeSize)
+	if _, err := decodeVgsMetricsJSON(metricReport("vg", []map[string]string{row})); err == nil {
+		t.Fatal("missing VG measurement became zero")
+	}
+}
+func TestMetricsAbsentHealthIsUnknownWhilePresentEmptyIsHealthy(t *testing.T) {
+	row := metricLV("pool", "thin-pool", "", "", "/dev/mapper/pgcf-pool", "active")
+	delete(row, LVHealthStatus)
+	unknown, err := parseLogicalVolumeMetrics(row)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if unknown.HealthStatus != -1 {
+		t.Fatal("an absent health field became healthy")
+	}
+	row[LVHealthStatus] = ""
+	healthy, err := parseLogicalVolumeMetrics(row)
+	if err != nil || healthy.HealthStatus != 0 {
+		t.Fatal("LVM's explicitly empty healthy status was lost")
+	}
+}
--- a/pkg/collector/exporter_metadata_test.go
+++ b/pkg/collector/exporter_metadata_test.go
@@ -0,0 +1,40 @@
+// Copyright 2026 PGCF contributors
+// SPDX-License-Identifier: Apache-2.0
+package collector
+
+import (
+	"github.com/openebs/lvm-localpv/pkg/lvm"
+	"github.com/prometheus/client_golang/prometheus"
+	dto "github.com/prometheus/client_model/go"
+	"strings"
+	"testing"
+)
+
+func TestMetricsEmitterKeepsInventoryWithoutInventingUtilization(t *testing.T) {
+	c := NewLvCollector().(*lvCollector)
+	rows := []lvm.LogicalVolumeMetrics{
+		{LogicalVolume: lvm.LogicalVolume{Name: "pgcf_thinpool", UUID: "pool", VGName: "pgcf", SegType: "thin-pool", Size: 16777216, DMPath: "/dev/mapper/pgcf-pgcf_thinpool", ActiveStatus: "active", Permission: 1, MetadataSize: 4194304}, MetadataSizeKnown: true},
+		{LogicalVolume: lvm.LogicalVolume{Name: "scratch", UUID: "raw", VGName: "pgcf", SegType: "thin", PoolName: "pgcf_thinpool", Size: 33554432, Path: "/dev/pgcf/scratch", DMPath: "/dev/mapper/pgcf-scratch", ActiveStatus: "active", Permission: 1}},
+		{LogicalVolume: lvm.LogicalVolume{Name: "spare", UUID: "spare", VGName: "pgcf", SegType: "linear", Size: 4194304, ActiveStatus: "inactive", Permission: 1}},
+	}
+	out := make(chan prometheus.Metric, 128)
+	c.collect(rows, out)
+	close(out)
+	totals := 0
+	usage := 0
+	for metric := range out {
+		var value dto.Metric
+		if err := metric.Write(&value); err != nil {
+			t.Fatal(err)
+		}
+		if strings.Contains(metric.Desc().String(), `fqName: "lvm_lv_total_size_bytes"`) {
+			totals++
+		}
+		if strings.Contains(metric.Desc().String(), `fqName: "lvm_lv_used_percent"`) || strings.Contains(metric.Desc().String(), `fqName: "lvm_lv_mda_used_percent"`) {
+			usage++
+		}
+	}
+	if totals != 3 || usage != 0 {
+		t.Fatalf("visible LV size rows=%d utilization rows=%d", totals, usage)
+	}
+}
