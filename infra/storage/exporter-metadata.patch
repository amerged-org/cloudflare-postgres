@@ -0,0 +1,195 @@
+// Copyright 2026 PGCF contributors
+// SPDX-License-Identifier: Apache-2.0
+package lvm
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"reflect"
+	"strconv"
+	"strings"
+
+	apis "github.com/openebs/lvm-localpv/pkg/apis/openebs.io/lvm/v1alpha1"
+	"k8s.io/apimachinery/pkg/api/resource"
+)
+
+// LogicalVolumeMetrics carries measured metadata, not CSI device-path readiness.
+// Missing utilization is distinguished from a measured zero and is not exported.
+type LogicalVolumeMetrics struct {
+	LogicalVolume
+	MetadataSizeKnown        bool
+	UsedSizePercentKnown     bool
+	MetadataUsedPercentKnown bool
+	SnapshotUsedPercentKnown bool
+}
+
+func metadataRows(raw []byte, kind string) ([]map[string]string, error) {
+	var output struct {
+		Report []map[string][]map[string]string `json:"report"`
+	}
+	if err := json.Unmarshal(raw, &output); err != nil {
+		return nil, err
+	}
+	if len(output.Report) != 1 {
+		return nil, fmt.Errorf("expected exactly one lvm metadata report")
+	}
+	rows, ok := output.Report[0][kind]
+	if !ok {
+		return nil, fmt.Errorf("lvm metadata report lacks %s inventory", kind)
+	}
+	return rows, nil
+}
+
+func metadataBytes(raw string) (int64, error) {
+	value, err := strconv.ParseInt(strings.TrimSuffix(strings.ToLower(raw), "b"), 10, 64)
+	if err != nil || value < 0 {
+		return 0, fmt.Errorf("invalid measured lvm byte count")
+	}
+	return value, nil
+}
+
+func metadataPercent(raw string) (float64, bool, error) {
+	if raw == "" {
+		return 0, false, nil
+	}
+	value, err := strconv.ParseFloat(raw, 64)
+	if err != nil || math.IsNaN(value) || math.IsInf(value, 0) || value < 0 || value > 100 {
+		return 0, false, fmt.Errorf("invalid measured lvm utilization")
+	}
+	return value, true, nil
+}
+
+// An absent field is unknown; an explicitly reported empty health string is
+// LVM's healthy value. Keep the two cases distinct for every measured enum.
+func metadataEnum(row map[string]string, field string) int {
+	value, present := row[field]
+	if !present {
+		return -1
+	}
+	return getIntFieldValue(field, value)
+}
+
+// No public LV alias is opened or resolved. Kernel minor metadata supplies the
+// convenience dm-N label when LVM actually reports an active kernel device.
+func parseLogicalVolumeMetrics(row map[string]string) (LogicalVolumeMetrics, error) {
+	var metric LogicalVolumeMetrics
+	lv := &metric.LogicalVolume
+	lv.Name, lv.FullName, lv.UUID, lv.VGName = row[LVName], row[LVFullName], row[LVUUID], row[VGName]
+	if lv.Name == "" || lv.UUID == "" || lv.VGName == "" {
+		return metric, fmt.Errorf("lvm metadata LV identity missing")
+	}
+	lv.Path, lv.DMPath, lv.ActiveStatus = row[LVPath], row[LVDmPath], row[LVActive]
+	lv.SegType, lv.Host, lv.PoolName = row[LVSegtype], row[LVHost], row[LVPool]
+	lv.Permission = metadataEnum(row, LVPermissions)
+	lv.BehaviourWhenFull = metadataEnum(row, LVWhenFull)
+	lv.HealthStatus = metadataEnum(row, LVHealthStatus)
+	lv.RaidSyncAction = metadataEnum(row, RaidSyncAction)
+	var err error
+	if lv.Size, err = metadataBytes(row[LVSize]); err != nil {
+		return metric, err
+	}
+	metric.MetadataSizeKnown = row[LVMetadataSize] != ""
+	if metric.MetadataSizeKnown {
+		if lv.MetadataSize, err = metadataBytes(row[LVMetadataSize]); err != nil {
+			return metric, err
+		}
+	}
+	if lv.UsedSizePercent, metric.UsedSizePercentKnown, err = metadataPercent(row[LVDataPercent]); err != nil {
+		return metric, err
+	}
+	if lv.MetadataUsedPercent, metric.MetadataUsedPercentKnown, err = metadataPercent(row[LVMetadataPercent]); err != nil {
+		return metric, err
+	}
+	if lv.SnapshotUsedPercent, metric.SnapshotUsedPercentKnown, err = metadataPercent(row[LVSnapPercent]); err != nil {
+		return metric, err
+	}
+	major, majorErr := strconv.ParseUint(row["lv_kernel_major"], 10, 32)
+	minor, minorErr := strconv.ParseUint(row["lv_kernel_minor"], 10, 32)
+	if majorErr == nil && minorErr == nil && major > 0 {
+		lv.Device = fmt.Sprintf("dm-%d", minor)
+	}
+	return metric, nil
+}
+
+func decodeLvsMetricsJSON(raw []byte) ([]LogicalVolumeMetrics, error) {
+	rows, err := metadataRows(raw, "lv")
+	if err != nil {
+		return nil, err
+	}
+	result := make([]LogicalVolumeMetrics, 0, len(rows))
+	seen := make(map[string]LogicalVolumeMetrics)
+	for _, row := range rows {
+		lv, err := parseLogicalVolumeMetrics(row)
+		if err != nil {
+			return nil, err
+		}
+		if previous, exists := seen[lv.UUID]; exists {
+			if !reflect.DeepEqual(previous, lv) {
+				return nil, fmt.Errorf("conflicting measured LV segment reports")
+			}
+			continue
+		}
+		seen[lv.UUID] = lv
+		result = append(result, lv)
+	}
+	return result, nil
+}
+
+func ListLVMLogicalVolumeMetrics() ([]LogicalVolumeMetrics, error) {
+	output, _, err := RunCommandSplit(LVList, "--options", "lv_all,vg_name,segtype", "--reportformat", "json", "--units", "b")
+	if err != nil {
+		return nil, err
+	}
+	return decodeLvsMetricsJSON(output)
+}
+
+// The exporter needs only vgs measurements. CSI's unchanged parseVolumeGroup
+// still performs thin-pool capacity enrichment; missing pool utilization must
+// not erase otherwise complete VG measurements from the exporter.
+func decodeVgsMetricsJSON(raw []byte) ([]apis.VolumeGroup, error) {
+	rows, err := metadataRows(raw, "vg")
+	if err != nil {
+		return nil, err
+	}
+	result := make([]apis.VolumeGroup, 0, len(rows))
+	for _, row := range rows {
+		var vg apis.VolumeGroup
+		vg.Name, vg.UUID = row[VGName], row[VGUUID]
+		if vg.Name == "" || vg.UUID == "" {
+			return nil, fmt.Errorf("lvm metadata VG identity missing")
+		}
+		counts := map[string]*int32{
+			VGPVvount: &vg.PVCount, VGLvCount: &vg.LVCount, VGMaxLv: &vg.MaxLV, VGMaxPv: &vg.MaxPV,
+			VGSnapCount: &vg.SnapCount, VGMissingPvCount: &vg.MissingPVCount,
+			VGMetadataCount: &vg.MetadataCount, VGMetadataUsedCount: &vg.MetadataUsedCount,
+		}
+		for key, target := range counts {
+			value, err := strconv.ParseInt(row[key], 10, 32)
+			if err != nil || value < 0 {
+				return nil, fmt.Errorf("invalid measured VG count %s", key)
+			}
+			*target = int32(value)
+		}
+		quantities := map[string]*resource.Quantity{VGSize: &vg.Size, VGFreeSize: &vg.Free, VGMetadataSize: &vg.MetadataSize, VGMetadataFreeSize: &vg.MetadataFree}
+		for key, target := range quantities {
+			value, err := metadataBytes(row[key])
+			if err != nil {
+				return nil, err
+			}
+			*target = *resource.NewQuantity(value, resource.BinarySI)
+		}
+		vg.Permission = metadataEnum(row, VGPermissions)
+		vg.AllocationPolicy = metadataEnum(row, VGAllocationPolicy)
+		result = append(result, vg)
+	}
+	return result, nil
+}
+
+func ListLVMVolumeGroupMetrics() ([]apis.VolumeGroup, error) {
+	output, _, err := RunCommandSplit(VGList, "--options", "vg_all", "--reportformat", "json", "--units", "b")
+	if err != nil {
+		return nil, err
+	}
+	return decodeVgsMetricsJSON(output)
+}
