+// SPDX-License-Identifier: Apache-2.0
+package driver
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"github.com/container-storage-interface/spec/lib/go/csi"
+	"github.com/openebs/lvm-localpv/pkg/volumegate"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestPoolDenialPrecedesEveryPublishAndExpansionPath(t *testing.T) {
+	// These are the actual CSI methods, with a real durable on-disk denial. No API/mount is mocked.
+	if err := os.MkdirAll(volumegate.Root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(volumegate.Root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	volume := "pvc-real-driver-denial"
+	sum := sha256.Sum256([]byte(volume))
+	base := filepath.Join(volumegate.Root, hex.EncodeToString(sum[:]))
+	if err := os.WriteFile(base+".deny", []byte("actual durable denial"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	defer os.Remove(base + ".deny")
+	defer os.Remove(base + ".lock")
+	ns := &node{}
+	mount := &csi.VolumeCapability{AccessType: &csi.VolumeCapability_Mount{Mount: &csi.VolumeCapability_MountVolume{FsType: "ext4"}}}
+	_, err := ns.NodePublishVolume(context.Background(), &csi.NodePublishVolumeRequest{VolumeId: volume, VolumeCapability: mount, TargetPath: "/tmp/pool-gate-forbidden"})
+	if status.Code(err) != codes.FailedPrecondition {
+		t.Fatal("filesystem publish did not refuse before external reads/mount")
+	}
+	block := &csi.VolumeCapability{AccessType: &csi.VolumeCapability_Block{Block: &csi.VolumeCapability_BlockVolume{}}}
+	_, err = ns.NodePublishVolume(context.Background(), &csi.NodePublishVolumeRequest{VolumeId: volume, VolumeCapability: block, TargetPath: "/tmp/pool-gate-forbidden"})
+	if status.Code(err) != codes.FailedPrecondition {
+		t.Fatal("raw-block publish did not refuse before external reads/mount")
+	}
+	_, err = ns.NodeExpandVolume(context.Background(), &csi.NodeExpandVolumeRequest{VolumeId: volume, VolumePath: "/tmp/pool-gate-forbidden", VolumeCapability: mount})
+	if status.Code(err) != codes.FailedPrecondition {
+		t.Fatal("expansion did not refuse before external reads/resize")
+	}
+}
