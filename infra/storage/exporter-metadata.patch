+// SPDX-License-Identifier: Apache-2.0
+// PGCF protocol 1: serialize platform volume access against a crash-durable owner denial.
+package volumegate
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"os"
+	"path/filepath"
+	"syscall"
+	"time"
+)
+
+const Root = "/var/lib/kubelet/pgcf-pool-gates"
+
+var ErrDenied = errors.New("pool_creator_fence_denied")
+
+type Guard struct {
+	file   *os.File
+	record string
+}
+
+func validVolume(volume string) bool {
+	if len(volume) == 0 || len(volume) > 128 {
+		return false
+	}
+	for _, c := range volume {
+		if !(c >= 'a' && c <= 'z' || c >= '0' && c <= '9' || c == '-') {
+			return false
+		}
+	}
+	return true
+}
+func acquireAt(root, volume string) (*Guard, error) {
+	return acquire(context.Background(), root, volume)
+}
+func acquire(ctx context.Context, root, volume string) (*Guard, error) {
+	if !validVolume(volume) {
+		return nil, ErrDenied
+	}
+	if err := os.Mkdir(root, 0700); err != nil && !os.IsExist(err) {
+		return nil, ErrDenied
+	}
+	resolved, err := filepath.EvalSymlinks(root)
+	if err != nil || resolved != root {
+		return nil, ErrDenied
+	}
+	meta, err := os.Lstat(root)
+	if err != nil || !meta.IsDir() || meta.Mode().Perm() != 0700 {
+		return nil, ErrDenied
+	}
+	stat, ok := meta.Sys().(*syscall.Stat_t)
+	if !ok || stat.Uid != 0 {
+		return nil, ErrDenied
+	}
+	sum := sha256.Sum256([]byte(volume))
+	key := hex.EncodeToString(sum[:])
+	fd, err := syscall.Open(filepath.Join(root, key+".lock"), syscall.O_RDWR|syscall.O_CREAT|syscall.O_NOFOLLOW|syscall.O_CLOEXEC, 0600)
+	if err != nil {
+		return nil, ErrDenied
+	}
+	file := os.NewFile(uintptr(fd), "pool-volume-lock")
+	meta, err = file.Stat()
+	if err != nil {
+		file.Close()
+		return nil, ErrDenied
+	}
+	stat, ok = meta.Sys().(*syscall.Stat_t)
+	if !ok || !meta.Mode().IsRegular() || meta.Mode().Perm() != 0600 || stat.Uid != 0 || stat.Nlink != 1 {
+		file.Close()
+		return nil, ErrDenied
+	}
+	for {
+		err = syscall.Flock(fd, syscall.LOCK_EX|syscall.LOCK_NB)
+		if err == nil {
+			break
+		}
+		if err != syscall.EWOULDBLOCK && err != syscall.EAGAIN {
+			file.Close()
+			return nil, ErrDenied
+		}
+		select {
+		case <-ctx.Done():
+			file.Close()
+			return nil, ErrDenied
+		case <-time.After(10 * time.Millisecond):
+		}
+	}
+	return &Guard{file: file, record: filepath.Join(root, key+".deny")}, nil
+}
+
+// Acquire checks durable absence AFTER serialization. Presence, invalidity and stale state all deny.
+func Acquire(ctx context.Context, volume string) (*Guard, error) {
+	guard, err := acquire(ctx, Root, volume)
+	if err != nil {
+		return nil, ErrDenied
+	}
+	if !guard.allowed() {
+		guard.Close()
+		return nil, ErrDenied
+	}
+	return guard, nil
+}
+func (g *Guard) allowed() bool {
+	_, err := os.Lstat(g.record)
+	return os.IsNotExist(err)
+}
+
+// Do not unlink either file: queued waiters must retain the shared lock inode; only agent clears denial.
+func (g *Guard) Close() error { return g.file.Close() }
