@@ -0,0 +1,116 @@
+// Copyright 2026 PGCF contributors
+// SPDX-License-Identifier: Apache-2.0
+package lvm
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func metricLV(name, segtype, pool, path, dmPath, active string) map[string]string {
+	return map[string]string{
+		LVName: name, LVFullName: "pgcf/" + name, LVUUID: name + "-uuid", VGName: "pgcf",
+		LVSize: "4194304B", LVPath: path, LVDmPath: dmPath, LVActive: active,
+		LVPermissions: "writeable", LVWhenFull: "error", LVHealthStatus: "",
+		LVSegtype: segtype, LVPool: pool, LVHost: "probe",
+		LVMetadataSize: "4194304B", LVDataPercent: "", LVMetadataPercent: "", LVSnapPercent: "",
+	}
+}
+func metricReport(kind string, rows []map[string]string) []byte {
+	out, err := json.Marshal(map[string]any{"report": []any{map[string]any{kind: rows}}})
+	if err != nil {
+		panic(err)
+	}
+	return out
+}
+func TestMetricsInventoryDoesNotRequirePublicDevicePaths(t *testing.T) {
+	rows := []map[string]string{
+		metricLV("pgcf_thinpool", "thin-pool", "", "", "/dev/mapper/pgcf-pgcf_thinpool", "active"),
+		metricLV("pgcf_thin_q_probe_m", "thin", "pgcf_thinpool", "/dev/pgcf/pgcf_thin_q_probe_m", "/dev/mapper/pgcf-pgcf_thin_q_probe_m", "active"),
+		metricLV("metadata_spare", "linear", "", "", "", "inactive"),
+	}
+	got, err := decodeLvsMetricsJSON(metricReport("lv", rows))
+	if err != nil {
+		t.Fatalf("complete measured LV inventory was lost because a public alias is absent: %v", err)
+	}
+	if len(got) != len(rows) {
+		t.Fatalf("measured visible LV count = %d; want %d", len(got), len(rows))
+	}
+}
+
+func TestMetricsUnknownUtilizationIsDistinctFromMeasuredZero(t *testing.T) {
+	row := metricLV("pool", "thin-pool", "", "", "/dev/mapper/pgcf-pool", "inactive")
+	unknown, err := parseLogicalVolumeMetrics(row)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if unknown.UsedSizePercentKnown || unknown.MetadataUsedPercentKnown || unknown.SnapshotUsedPercentKnown {
+		t.Fatal("missing utilization became a measurement")
+	}
+	row[LVDataPercent] = "0.00"
+	row[LVMetadataPercent] = "0.00"
+	zero, err := parseLogicalVolumeMetrics(row)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !zero.UsedSizePercentKnown || !zero.MetadataUsedPercentKnown || zero.UsedSizePercent != 0 || zero.MetadataUsedPercent != 0 {
+		t.Fatal("a measured zero was lost")
+	}
+	row[LVDataPercent] = "NaN"
+	if _, err := parseLogicalVolumeMetrics(row); err == nil {
+		t.Fatal("invalid utilization was accepted")
+	}
+}
+func TestMetricsSegmentDuplicatesPreserveOneCompleteInventory(t *testing.T) {
+	row := metricLV("pool", "thin-pool", "", "", "/dev/mapper/pgcf-pool", "active")
+	got, err := decodeLvsMetricsJSON(metricReport("lv", []map[string]string{row, row}))
+	if err != nil || len(got) != 1 {
+		t.Fatalf("same-LV segment rows: count=%d err=%v", len(got), err)
+	}
+	different := metricLV("pool", "thin-pool", "", "", "/dev/mapper/pgcf-pool", "active")
+	different[LVSize] = "8388608B"
+	if _, err := decodeLvsMetricsJSON(metricReport("lv", []map[string]string{row, different})); err == nil {
+		t.Fatal("conflicting segment rows were silently dropped")
+	}
+	if _, err := decodeLvsJSON(metricReport("lv", []map[string]string{metricLV("missing", "linear", "", "/definitely-absent-lv", "", "active")})); err == nil {
+		t.Fatal("CSI device-path checks were weakened")
+	}
+}
+func TestMetricsVolumeGroupReadDoesNotRequireThinPoolCapacity(t *testing.T) {
+	row := map[string]string{VGName: "pgcf", VGUUID: "vg-uuid", VGSize: "103075020800B", VGFreeSize: "51531218944B", VGMetadataSize: "1048576B", VGMetadataFreeSize: "524288B", VGPermissions: "writeable", VGAllocationPolicy: "normal"}
+	for _, key := range []string{VGPVvount, VGLvCount, VGMaxLv, VGMaxPv, VGSnapCount, VGMissingPvCount, VGMetadataCount, VGMetadataUsedCount} {
+		row[key] = "0"
+	}
+	row[VGPVvount] = "1"
+	row[VGLvCount] = "6"
+	got, err := decodeVgsMetricsJSON(metricReport("vg", []map[string]string{row}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 || got[0].LVCount != 6 || got[0].Size.Value() != 103075020800 || got[0].Free.Value() != 51531218944 {
+		t.Fatal("independent vgs facts were lost")
+	}
+	if len(got[0].ThinPools) != 0 {
+		t.Fatal("exporter invented thin-pool capacity")
+	}
+	delete(row, VGFreeSize)
+	if _, err := decodeVgsMetricsJSON(metricReport("vg", []map[string]string{row})); err == nil {
+		t.Fatal("missing VG measurement became zero")
+	}
+}
+func TestMetricsAbsentHealthIsUnknownWhilePresentEmptyIsHealthy(t *testing.T) {
+	row := metricLV("pool", "thin-pool", "", "", "/dev/mapper/pgcf-pool", "active")
+	delete(row, LVHealthStatus)
+	unknown, err := parseLogicalVolumeMetrics(row)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if unknown.HealthStatus != -1 {
+		t.Fatal("an absent health field became healthy")
+	}
+	row[LVHealthStatus] = ""
+	healthy, err := parseLogicalVolumeMetrics(row)
+	if err != nil || healthy.HealthStatus != 0 {
+		t.Fatal("LVM's explicitly empty healthy status was lost")
+	}
+}
