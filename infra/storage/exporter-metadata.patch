+// SPDX-License-Identifier: Apache-2.0
+package volumegate
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestQueuedPublishSeesDurableDenialAfterOwnerUnlock(t *testing.T) {
+	root := t.TempDir()
+	if err := os.Chmod(root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	volume := "pvc-real-process-queue"
+	owner, err := acquireAt(root, volume)
+	if err != nil {
+		t.Fatal(err)
+	}
+	child := exec.Command(os.Args[0], "-test.run=^TestQueuedPublishChild$")
+	child.Env = append(os.Environ(), "PGCF_GATE_TEST_ROOT="+root, "PGCF_GATE_TEST_VOLUME="+volume)
+	if err = child.Start(); err != nil {
+		t.Fatal(err)
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		if _, err = os.Stat(filepath.Join(root, "queued")); err == nil {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("real queued publisher did not start")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	// This is an actual record written by the owner while holding the shared inode lock.
+	if err = os.WriteFile(owner.record, []byte(`{"v":1,"volume_handle":"pvc-real-process-queue","scope_sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err = owner.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err = child.Wait(); err != nil {
+		t.Fatal("queued publisher bypassed durable denial")
+	}
+	// Restart/death cannot turn an existing record into an allowed operation.
+	restarted, err := acquireAt(root, volume)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer restarted.Close()
+	if restarted.allowed() {
+		t.Fatal("owner restart cleared denial")
+	}
+}
+
+func TestQueuedPublishChild(t *testing.T) {
+	root := os.Getenv("PGCF_GATE_TEST_ROOT")
+	if root == "" {
+		return
+	}
+	if err := os.WriteFile(filepath.Join(root, "queued"), []byte("ready"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	guard, err := acquireAt(root, os.Getenv("PGCF_GATE_TEST_VOLUME"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer guard.Close()
+	if guard.allowed() {
+		t.Fatal("publish allowed after claim")
+	}
+}
+
+func TestSymlinkOrMalformedRecordCannotPermitPublish(t *testing.T) {
+	root := t.TempDir()
+	if err := os.Chmod(root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	guard, err := acquireAt(root, "pvc-real-invalid-record")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer guard.Close()
+	if err = os.Symlink("/not-present", guard.record); err != nil {
+		t.Fatal(err)
+	}
+	if guard.allowed() {
+		t.Fatal("dangling symlink treated as absent record")
+	}
+}
