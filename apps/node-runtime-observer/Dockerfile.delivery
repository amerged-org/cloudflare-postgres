# SPDX-License-Identifier: Apache-2.0
FROM golang:1.27.1-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS build
WORKDIR /source
COPY apps/node-runtime-observer/go.mod apps/node-runtime-observer/go.sum ./
COPY apps/execution-guard/go.mod apps/execution-guard/go.sum /execution-guard/
COPY apps/execution-guard/*.go /execution-guard/
COPY LICENSE /execution-guard/LICENSE
RUN go mod download
COPY apps/node-runtime-observer/observer ./observer
COPY apps/node-runtime-observer/delivery ./delivery
COPY apps/node-runtime-observer/cmd/node-execution-delivery ./cmd/node-execution-delivery
COPY apps/node-runtime-observer/collect-notices.sh ./collect-notices.sh
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/node-execution-delivery ./cmd/node-execution-delivery
RUN sh ./collect-notices.sh

FROM scratch
COPY --from=build /out/node-execution-delivery /node-execution-delivery
COPY --from=build /out/licenses /licenses
COPY LICENSE /LICENSE
COPY apps/node-runtime-observer/THIRD_PARTY.md /THIRD_PARTY.md
USER 0:0
ENTRYPOINT ["/node-execution-delivery"]
