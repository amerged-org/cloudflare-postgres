{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pgcf-api-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  // The daily infrastructure backup streams AES-256-GCM through node:crypto.
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pgcf-api-test",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "pgcf-api-test",
      "jurisdiction": "eu",
    },
    { "binding": "ARCHIVE_US", "bucket_name": "pgcf-api-us-test" },
  ],
  "vars": {
    "CONTABO_NODE_FIREWALL_ID": "<CONTABO_NODE_FIREWALL_ID>",
    "CONTABO_ORDER_DEFAULT_USER": "<CONTABO_ORDER_DEFAULT_USER>",
    "CONTABO_ORDER_SSH_KEY_IDS": "<CONTABO_ORDER_SSH_KEY_IDS_JSON>",
    "DB_ENDPOINT_HOST": "<DB_ENDPOINT_HOST>",
    "ARCHIVE_BUCKET_NAME": "pgcf-api-test",
    // The keep-warm is off: a warmer's alarm would visit actors, and read D1, in the middle of
    // another test. The tests of the keep-warm arm it with an interval of their own.
    "DATABASE_ACTOR_WARM_INTERVAL_MS": "0",
  },
  "durable_objects": {
    "bindings": [
      { "name": "NODE_ACTOR", "class_name": "NodeActor" },
      { "name": "DATABASE_ACTOR", "class_name": "DatabaseActor" },
      { "name": "CRON_WATCHDOG", "class_name": "CronWatchdog" },
      { "name": "ACTOR_WARMER", "class_name": "ActorWarmer" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RegionLink"] },
    { "tag": "v2", "new_sqlite_classes": ["DatabaseActor"] },
    { "tag": "v3", "new_sqlite_classes": ["NodeBootstrap"] },
    { "tag": "v4", "new_sqlite_classes": ["CronWatchdog"] },
    { "tag": "v5", "deleted_classes": ["NodeBootstrap"] },
    // One NodeActor per node replaces the per-region link.
    {
      "tag": "v6",
      "new_sqlite_classes": ["NodeActor"],
      "deleted_classes": ["RegionLink"],
    },
    { "tag": "v7", "new_sqlite_classes": ["ActorWarmer"] },
  ],
  "workflows": [
    {
      "binding": "INFRASTRUCTURE_BACKUP",
      "name": "pgcf-infrastructure-backup",
      "class_name": "InfrastructureBackup",
    },
    { "binding": "ADD_NODE", "name": "pgcf-add-node", "class_name": "AddNode" },
  ],
  "triggers": { "crons": ["* * * * *"] },
}
