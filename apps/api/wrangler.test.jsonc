{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pgcf-api-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pgcf-api-test",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "pgcf-api-test",
      "jurisdiction": "eu",
    },
  ],
  "vars": {
    "DB_ENDPOINT_HOST": "<DB_ENDPOINT_HOST>",
    "ARCHIVE_BUCKET_NAME": "pgcf-api-test",
  },
  "durable_objects": {
    "bindings": [
      { "name": "REGION_LINK", "class_name": "RegionLink" },
      { "name": "DATABASE_ACTOR", "class_name": "DatabaseActor" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RegionLink"] },
    { "tag": "v2", "new_sqlite_classes": ["DatabaseActor"] },
  ],
  "triggers": { "crons": ["* * * * *"] },
}
