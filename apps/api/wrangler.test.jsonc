{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pgcf-api-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pgcf-api-test",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "pgcf-api-test",
      "jurisdiction": "eu",
    },
  ],
  "vars": {
    "NODE_BOOTSTRAP_CALLBACK_URL": "<NODE_BOOTSTRAP_CALLBACK_URL>",
    "BOOTSTRAP_RELAY_URL": "<BOOTSTRAP_RELAY_URL>",
    "BOOTSTRAP_RELAY_ISSUER_REGION": "<BOOTSTRAP_RELAY_ISSUER_REGION>",
    "BOOTSTRAP_VERIFIER_KEYS": "<DEDICATED_VERIFIER_PUBLIC_KEYS_JSON>",
    "CONTABO_ORDER_DEFAULT_USER": "<CONTABO_ORDER_DEFAULT_USER>",
    "CONTABO_ORDER_SSH_KEY_IDS": "<CONTABO_ORDER_SSH_KEY_IDS_JSON>",
    "CONTABO_RESCUE_SSH_KEY_IDS": "<CONTABO_RESCUE_SSH_KEY_IDS_JSON>",
    "DB_ENDPOINT_HOST": "<DB_ENDPOINT_HOST>",
    "ARCHIVE_BUCKET_NAME": "pgcf-api-test",
  },
  "durable_objects": {
    "bindings": [
      { "name": "REGION_LINK", "class_name": "RegionLink" },
      { "name": "DATABASE_ACTOR", "class_name": "DatabaseActor" },
      { "name": "NODE_BOOTSTRAP", "class_name": "NodeBootstrap" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RegionLink"] },
    { "tag": "v2", "new_sqlite_classes": ["DatabaseActor"] },
    { "tag": "v3", "new_sqlite_classes": ["NodeBootstrap"] },
  ],
  "workflows": [
    { "binding": "ADD_NODE", "name": "pgcf-add-node", "class_name": "AddNode" },
  ],
  "triggers": { "crons": ["* * * * *"] },
}
