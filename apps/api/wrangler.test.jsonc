{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pgcf-api-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  // The daily infrastructure backup streams AES-256-GCM through node:crypto.
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pgcf-api-test",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "pgcf-api-test",
      "jurisdiction": "eu",
    },
    { "binding": "ARCHIVE_US", "bucket_name": "pgcf-api-us-test" },
  ],
  "vars": {
    "BOOTSTRAP_FIREWALL_BINDINGS": "<PROVIDER_INSTANCE_FIREWALL_UUID_MAP_JSON>",
    "CONTABO_ORDER_DEFAULT_USER": "<CONTABO_ORDER_DEFAULT_USER>",
    "CONTABO_ORDER_SSH_KEY_IDS": "<CONTABO_ORDER_SSH_KEY_IDS_JSON>",
    "DB_ENDPOINT_HOST": "<DB_ENDPOINT_HOST>",
    "ARCHIVE_BUCKET_NAME": "pgcf-api-test",
  },
  "durable_objects": {
    "bindings": [
      { "name": "REGION_LINK", "class_name": "RegionLink" },
      { "name": "DATABASE_ACTOR", "class_name": "DatabaseActor" },
      { "name": "CRON_WATCHDOG", "class_name": "CronWatchdog" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RegionLink"] },
    { "tag": "v2", "new_sqlite_classes": ["DatabaseActor"] },
    { "tag": "v3", "new_sqlite_classes": ["NodeBootstrap"] },
    { "tag": "v4", "new_sqlite_classes": ["CronWatchdog"] },
    { "tag": "v5", "deleted_classes": ["NodeBootstrap"] },
  ],
  "workflows": [
    {
      "binding": "INFRASTRUCTURE_BACKUP",
      "name": "pgcf-infrastructure-backup",
      "class_name": "InfrastructureBackup",
    },
    { "binding": "ADD_NODE", "name": "pgcf-add-node", "class_name": "AddNode" },
  ],
  "triggers": { "crons": ["* * * * *"] },
}
