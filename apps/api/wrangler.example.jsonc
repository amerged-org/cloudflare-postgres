{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pgcf-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  // The daily infrastructure backup streams AES-256-GCM through node:crypto.
  "compatibility_flags": ["nodejs_compat"],
  // Every cold Durable Object, a DatabaseActor included, loads this whole bundle in an isolate of its own
  // before it answers: a smaller bundle answers sooner.
  "minify": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "<D1_DATABASE_NAME>",
      "database_id": "<D1_DATABASE_ID>",
      "migrations_dir": "migrations",
    },
  ],
  // One R2 bucket for every region: the backups and WAL of all databases, the node image releases
  // and the infrastructure backups. Name it without a region. ARCHIVE_BUCKET_NAME below names the
  // same bucket, ARCHIVE_ENDPOINT_URL its S3 endpoint, and the archive paths in D1 and the nodes'
  // temporary credentials name them too.
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "replace-r2-backup-bucket",
      "jurisdiction": "eu",
    },
  ],
  // Optional authenticated alert receiver; direct Resend also supports API-configured sender/recipient.
  // "services": [{ "binding": "INFRASTRUCTURE_ALERT_WEBHOOK", "service": "your-alert-receiver", "entrypoint": "InfrastructureAlertsService" }],
  "vars": {
    // CONTROL_PLANE_MAINTENANCE="on" quiesces D1-facing HTTP/RPC/background work for a schema
    // cutover. Existing native SQL sessions are unchanged; new connections are temporarily refused.
    // Pause/drain existing Workflows separately and verify the paused version before migrating.
    // Registering a release and adding a node need NODE_API_ORIGIN (this Worker's https origin: it
    // names the URLs of a release's files, which the Worker streams from the ARCHIVE bucket's
    // node-images/ prefix, and it is where the installer enrolls), NODE_DNS_SERVERS (a JSON array of one to three resolver addresses the installed node
    // uses) and, for the node's Tunnel and its hostnames, NODE_GATEWAY_DOMAIN and
    // NODE_GATEWAY_ZONE_ID (see the secrets below). A node whose region has no release assigned
    // waits for one.
    // NATIVE_EXTENDED_RESOURCES_RELEASE_IDS: a JSON array of signed release IDs qualified for MiB
    // storage and restrictive role memberships. Unset/invalid means none; enable only after native
    // rollout and OS/readback verification. Keep compatible current and next release IDs during updates.
    // NODE_SHELL_HOSTNAME: "true" also gives each node a shell hostname (pgcf-shell-<id>.<domain>) on
    // its Tunnel; any other value, or none (the default), gives none and removes the one a node has.
    // Keep it off until Cloudflare Access guards the shell (scripts/operations/setup-access.ts
    // --shell): otherwise anyone who can run cloudflared reaches it.
    // NODE_SSH_USER_CA_PUBLIC_KEY: the public key of the CA the operator signs shell certificates
    // with, exactly one "ssh-ed25519 AAAA..." line without a comment. Nodes get it only while
    // NODE_SHELL_HOSTNAME is "true" and remove it when it goes; without a valid key nobody logs in.
    // The private key stays with the operator and is never set on any Worker.
    // Alternatively set INFRASTRUCTURE_ALERT_WEBHOOK_URL to the receiver's HTTPS endpoint.
    // Import INFRASTRUCTURE_ALERT_WEBHOOK_TOKEN as a private Worker secret.
    "DATABASE_CONNECTION_LIMIT_PER_MINUTE": "12000",
    // Durable Object location hint for new DatabaseActor objects, near the database regions and D1.
    // Set the same value on the Edge Worker. An existing object never moves.
    "DATABASE_ACTOR_LOCATION_HINT": "weur",
    // Location hint for new ActorWarmer objects, used only when DATABASE_ACTOR_LOCATION_HINT is not
    // set: put it where the DatabaseActors live, or each visit crosses an ocean and a cycle outlasts
    // its interval. The warmers are named "v2:<shard>", so a hint set later places new warmers; the
    // ones of the earlier name stop within the lease (docs/operations/operator-installation.md).
    // "ACTOR_WARMER_LOCATION_HINT": "weur",
    // Milliseconds between two visits of each DatabaseActor by the ActorWarmer objects, which keep its
    // isolate loaded so that the first admission after a quiet period is not a cold start: any value
    // from 1000 to 300000, 0 turns the keep-warm off, unset means 8000. A visit every 10 s or faster
    // keeps an actor warm; the cost grows with the visit rate (docs/operations/operator-installation.md).
    // With Workers Logs on, each visit may also be one billed invocation log event: the same page
    // says how to check it and how to turn it off ("observability.logs.invocation_logs": false).
    "DATABASE_ACTOR_WARM_INTERVAL_MS": "8000",
    // The id of the Contabo firewall every node sits behind: active, created once with no inbound
    // rule, as docs/operations/operator-installation.md describes. AddNode sends the installer's
    // rescue only once the firewall lists the instance.
    "CONTABO_NODE_FIREWALL_ID": "<CONTABO_NODE_FIREWALL_ID>",
    "CONTABO_ORDER_DEFAULT_USER": "<CONTABO_ORDER_DEFAULT_USER>",
    "CONTABO_ORDER_SSH_KEY_IDS": "<CONTABO_ORDER_SSH_KEY_IDS_JSON>",
    "DB_ENDPOINT_HOST": "<DB_ENDPOINT_HOST>",
    // The name of the bucket the ARCHIVE binding is bound to.
    "ARCHIVE_BUCKET_NAME": "replace-r2-backup-bucket",
    // The S3 endpoint of that bucket, the same for every region: the nodes' temporary credentials
    // name it, and its account is the one that holds the nodes' Tunnels. A bucket of the EU
    // jurisdiction (the binding's "jurisdiction": "eu") is served only at the ".eu." host.
    "ARCHIVE_ENDPOINT_URL": "https://<CLOUDFLARE_ACCOUNT_ID>.eu.r2.cloudflarestorage.com",
  },
  "durable_objects": {
    "bindings": [
      { "name": "NODE_ACTOR", "class_name": "NodeActor" },
      { "name": "DATABASE_ACTOR", "class_name": "DatabaseActor" },
      // Evaluates every alert once a minute from its own alarm and checks the minute cron's heartbeat
      // there; the cron only arms it. Keep the binding and the v4 migration in every deployed
      // configuration: without them no alert is evaluated and a stopped cron is not reported.
      { "name": "CRON_WATCHDOG", "class_name": "CronWatchdog" },
      // Visits every DatabaseActor every DATABASE_ACTOR_WARM_INTERVAL_MS from its alarm; the minute
      // cron arms it. Keep the binding and the v7 migration while the interval is not 0.
      { "name": "ACTOR_WARMER", "class_name": "ActorWarmer" },
      // Stores each database's webhook events and delivers them from its alarm. Keep the binding
      // and the v8 migration: without them no webhook is delivered.
      { "name": "TRIGGER_ACTOR", "class_name": "TriggerActor" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RegionLink"] },
    { "tag": "v2", "new_sqlite_classes": ["DatabaseActor"] },
    { "tag": "v3", "new_sqlite_classes": ["NodeBootstrap"] },
    { "tag": "v4", "new_sqlite_classes": ["CronWatchdog"] },
    { "tag": "v5", "deleted_classes": ["NodeBootstrap"] },
    // One NodeActor per node replaces the per-region link.
    {
      "tag": "v6",
      "new_sqlite_classes": ["NodeActor"],
      "deleted_classes": ["RegionLink"],
    },
    { "tag": "v7", "new_sqlite_classes": ["ActorWarmer"] },
    { "tag": "v8", "new_sqlite_classes": ["TriggerActor"] },
  ],
  "workflows": [
    {
      "binding": "INFRASTRUCTURE_BACKUP",
      "name": "pgcf-infrastructure-backup",
      "class_name": "InfrastructureBackup",
    },
    { "binding": "ADD_NODE", "name": "pgcf-add-node", "class_name": "AddNode" },
  ],
  "triggers": { "crons": ["* * * * *"] },
  // Optional private secrets: INFRASTRUCTURE_BACKUP_CF_TOKEN (D1 export), RESEND_API_KEY (email),
  // R2_PARENT_ACCESS_KEY_ID and R2_PARENT_SECRET_ACCESS_KEY (the parent key that signs the nodes' temporary
  // R2 credentials) and CLOUDFLARE_API_TOKEN (Account: Cloudflare Tunnel: Edit and Zone: DNS: Edit on the gateway
  // zone; edits the Tunnels and the DNS records of the nodes' gateways and deletes both of a node declared lost).
  // Their hostnames are made under NODE_GATEWAY_DOMAIN, a domain of the DNS zone NODE_GATEWAY_ZONE_ID; set both
  // as variables.
  // Enable backups and select actual D1 identity/R2 region through the management API.
  "secrets": {
    "required": [
      "API_KEY_PEPPER",
      "CREDENTIAL_KEYS",
      "ROUTE_MASTER_KEYS",
      "BOOTSTRAP_TOKEN",
      "CONTABO_CLIENT_ID",
      "CONTABO_CLIENT_SECRET",
      "CONTABO_USERNAME",
      "CONTABO_PASSWORD",
    ],
  },
}
