{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pgcf-edge-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pgcf-edge-test",
    },
  ],
  "ratelimits": [
    {
      "name": "DATABASE_CONNECTION_RATE_LIMITER",
      "namespace_id": "3",
      "simple": {
        "limit": 1000,
        "period": 60,
      },
    },
    {
      "name": "CONNECTION_RATE_LIMITER",
      "namespace_id": "1",
      "simple": {
        "limit": 1000,
        "period": 60,
      },
    },
  ],
}
