{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pgcf-edge-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "limits": {
    "cpu_ms": 300000,
  },
  "routes": [
    {
      "pattern": "<DB_ENDPOINT_HOST>",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "<CONTROL_DATABASE_NAME>",
      "database_id": "<CONTROL_DATABASE_ID>",
    },
  ],
  "ratelimits": [
    // Configure limits for the installation's new WebSocket handshakes.
    // SQL statements on an existing connection do not consume these buckets.
    // Counters are per Cloudflare location and eventually consistent.
    {
      "name": "DATABASE_CONNECTION_RATE_LIMITER",
      "namespace_id": "<DATABASE_RATE_LIMIT_NAMESPACE_ID>",
      // Aggregate per database across all roles and source networks.
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
    {
      "name": "CONNECTION_RATE_LIMITER",
      "namespace_id": "<RATE_LIMIT_NAMESPACE_ID>",
      // Per database + role + normalized network, never the whole endpoint.
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
  ],
  "secrets": {
    "required": ["ROUTE_MASTER_KEYS"],
  },
}
