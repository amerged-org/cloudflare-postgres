{
  "name": "cloudflare-postgres-control-api-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-27",
  "r2_buckets": [
    { "binding": "USAGE_ARCHIVES", "bucket_name": "usage-archives-test" },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "control-api-test",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
}
