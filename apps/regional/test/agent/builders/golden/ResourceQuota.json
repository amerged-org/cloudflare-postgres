[
  {
    "apiVersion": "v1",
    "kind": "ResourceQuota",
    "metadata": {
      "name": "database-resources",
      "namespace": "$NAMESPACE",
      "labels": {
        "pgcf.io/database-id": "$DATABASE_ID"
      }
    },
    "spec": {
      "hard": {
        "requests.cpu": "1200m",
        "limits.cpu": "2000m",
        "requests.memory": "1280Mi",
        "limits.memory": "2048Mi",
        "requests.storage": "5Gi",
        "persistentvolumeclaims": "1",
        "pods": "2"
      }
    }
  }
]
