[
  {
    "apiVersion": "postgresql.cnpg.io/v1",
    "kind": "Cluster",
    "metadata": {
      "name": "database",
      "namespace": "pgcf-db-$DATABASE_ID",
      "labels": {
        "pgcf.io/database-id": "$DATABASE_ID"
      }
    },
    "spec": {
      "instances": 1,
      "imageName": "ghcr.io/cloudnative-pg/postgresql:18.4-standard-trixie@sha256:ebf3919504d7523a63e8e2fee9b051211de714644b36469275558c624afd50ec",
      "inheritedMetadata": {
        "labels": {
          "pgcf.io/database-id": "$DATABASE_ID"
        }
      },
      "enableSuperuserAccess": false,
      "bootstrap": {
        "initdb": {
          "database": "$DATABASE_ID",
          "owner": "app",
          "secret": {
            "name": "role-app"
          }
        }
      },
      "affinity": {
        "nodeSelector": {
          "kubernetes.io/hostname": "$NODE"
        }
      },
      "resources": {
        "requests": {
          "cpu": "500m",
          "memory": "512Mi"
        },
        "limits": {
          "cpu": "500m",
          "memory": "512Mi"
        }
      },
      "seccompProfile": {
        "type": "RuntimeDefault"
      },
      "storage": {
        "storageClass": "pgcf-lvm",
        "size": "5Gi"
      },
      "postgresql": {
        "parameters": {
          "shared_buffers": "128MB",
          "effective_cache_size": "256MB",
          "max_connections": "30",
          "archive_timeout": "60s"
        },
        "pg_hba": ["hostnossl all all all reject"]
      },
      "managed": {
        "roles": [
          {
            "name": "reader_query",
            "ensure": "present",
            "login": true,
            "superuser": false,
            "createdb": false,
            "createrole": false,
            "replication": false,
            "bypassrls": false,
            "inherit": true,
            "passwordSecret": {
              "name": "role-h-1e7636804b5ef0e0a24870efce236d6a639e8637d64bad9f4f16164c"
            }
          }
        ]
      },
      "probes": {
        "startup": { "periodSeconds": 1, "failureThreshold": 3600 },
        "readiness": { "periodSeconds": 1 }
      },
      "plugins": [
        {
          "name": "barman-cloud.cloudnative-pg.io",
          "enabled": true,
          "isWALArchiver": true,
          "parameters": {
            "barmanObjectName": "archive",
            "serverName": "database"
          }
        }
      ]
    }
  }
]
