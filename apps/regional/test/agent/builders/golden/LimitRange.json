[
  {
    "apiVersion": "v1",
    "kind": "LimitRange",
    "metadata": {
      "name": "container-defaults",
      "namespace": "$NAMESPACE",
      "labels": {
        "pgcf.io/database-id": "$DATABASE_ID"
      }
    },
    "spec": {
      "limits": [
        {
          "type": "Container",
          "defaultRequest": {
            "cpu": "25m",
            "memory": "64Mi"
          },
          "default": {
            "cpu": "100m",
            "memory": "128Mi"
          }
        }
      ]
    }
  }
]
