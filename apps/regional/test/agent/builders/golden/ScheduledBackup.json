[
  {
    "apiVersion": "postgresql.cnpg.io/v1",
    "kind": "ScheduledBackup",
    "metadata": {
      "name": "daily-backup",
      "namespace": "pgcf-db-$DATABASE_ID",
      "labels": {
        "pgcf.io/database-id": "$DATABASE_ID"
      }
    },
    "spec": {
      "schedule": "0 0 3 * * *",
      "immediate": true,
      "backupOwnerReference": "cluster",
      "cluster": {
        "name": "database"
      },
      "method": "plugin",
      "pluginConfiguration": {
        "name": "barman-cloud.cloudnative-pg.io"
      }
    }
  }
]
