[
  {
    "apiVersion": "v1",
    "kind": "Namespace",
    "metadata": {
      "name": "pgcf-db-$DATABASE_ID",
      "labels": {
        "pgcf.io/database-id": "$DATABASE_ID",
        "pod-security.kubernetes.io/enforce": "restricted",
        "pod-security.kubernetes.io/enforce-version": "latest"
      }
    }
  }
]
