[
  {
    "apiVersion": "v1",
    "kind": "Secret",
    "metadata": {
      "name": "role-app",
      "namespace": "$NAMESPACE",
      "labels": {
        "pgcf.io/database-id": "$DATABASE_ID",
        "cnpg.io/reload": "true"
      }
    },
    "type": "kubernetes.io/basic-auth",
    "data": {
      "username": "$OWNER_USERNAME",
      "password": "$OWNER_PASSWORD"
    }
  },
  {
    "apiVersion": "v1",
    "kind": "Secret",
    "metadata": {
      "name": "$MANAGED_SECRET",
      "namespace": "$NAMESPACE",
      "labels": {
        "pgcf.io/database-id": "$DATABASE_ID",
        "cnpg.io/reload": "true"
      }
    },
    "type": "kubernetes.io/basic-auth",
    "data": {
      "username": "$MANAGED_USERNAME",
      "password": "$MANAGED_PASSWORD"
    }
  },
  {
    "apiVersion": "v1",
    "kind": "Secret",
    "metadata": {
      "name": "archive-credentials",
      "namespace": "$NAMESPACE",
      "labels": {
        "pgcf.io/database-id": "$DATABASE_ID"
      }
    },
    "type": "Opaque",
    "data": {
      "AWS_ACCESS_KEY_ID": "$ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY": "$SECRET_ACCESS_KEY"
    }
  }
]
