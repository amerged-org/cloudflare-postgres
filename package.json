{
  "name": "cloudflare-postgres",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "format:check": "pnpm --filter @cloudflare-postgres/control-api format:check",
    "lint": "pnpm --filter @cloudflare-postgres/control-api lint",
    "typecheck": "pnpm --filter @cloudflare-postgres/control-api typecheck",
    "vitest": "pnpm --filter @cloudflare-postgres/control-api exec vitest",
    "test:node": "node --test 'apps/**/*.node.test.mjs'"
  }
}
