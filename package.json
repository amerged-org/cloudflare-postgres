{
  "name": "cloudflare-postgres",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "format:check": "pnpm --filter './apps/*' format:check",
    "lint": "pnpm --filter './apps/*' lint",
    "typecheck": "pnpm --filter './apps/*' typecheck",
    "build:regional": "pnpm --filter @cloudflare-postgres/regional-controller build",
    "vitest": "pnpm --filter @cloudflare-postgres/control-api exec vitest",
    "test:node": "node --test 'apps/**/*.node.test.mjs'",
    "check:node-runtime": "cd apps/node-runtime-observer && test -z \"$(gofmt -l observer cmd)\" && go vet ./observer ./cmd/node-runtime-observer && go test ./observer -count=1 -timeout=90s"
  }
}
